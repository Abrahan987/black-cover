1791260816489},"AC35B4A2E83A91093529D5965413AB4A":{"sender":"50671011405@s.whatsapp.net","text":"Pero q cosas","type":"extendedTextMessage","timestamp":1791260889051},"AC05BB9D610F8456C35B43AC4BD65D59":{"sender":"50671011405@s.whatsapp.net","text":"No entiendo","type":"conversation","timestamp":1791260891759},"ACDE40A414839C82FF4D6A211FDFDEED":{"sender":"50662003841@s.whatsapp.net","text":"Te he hablado de eso varías veces, pero siempre me lo niegas, siempre, siempre, siempre...","type":"extendedTextMessage","timestamp":1791261316594},"AC36D930933AA87A2A8D032432BCACE8":{"sender":"50671011405@s.whatsapp.net","text":"Pero de q?","type":"extendedTextMessage","timestamp":1791261367904},"ACECF3CB939F6004C557DB534A857C24":{"sender":"50662003841@s.whatsapp.net","text":"No molesta, no enoja, decepciona saber la verdad por más que lo niegues. Un nombre soporta berrinches, malos compartimientos, pero siempre se quiebra al saber una mentira","type":"conversation","timestamp":1791261416131},"AC490ED55F5B1A7E943296836A060EE8":{"sender":"50662003841@s.whatsapp.net","text":"¿Te acuerdas de cambiar tu actitud?","type":"extendedTextMessage","timestamp":1791261453560},"AC5B79CBBF3B7F863ACB8F1D7081EDBB":{"sender":"50662003841@s.whatsapp.net","text":"No lo ibas a hacer, te iba aceptar en mí vida,","type":"conversation","timestamp":1791261473684},"ACC4EB58D813A5E8B75E3C97A2BFC02F":{"sender":"50671011405@s.whatsapp.net","text":"Pero q cosa?","type":"extendedTextMessage","timestamp":1791261492160},"AC233CC12ADB85C24CDD66D0F8748E92":{"sender":"50662003841@s.whatsapp.net","text":"Confíe en que no hablarías, confiando en eso le pase tu ig a mí amigo","type":"conversation","timestamp":1791261529897},"ACAB1CC5D35FA77A3DF004EB11DE6545":{"sender":"50662003841@s.whatsapp.net","text":"Y le terminaste","type":"conversation","timestamp":1791261563656},"ACE702B44C47B31A73F385D37C05C08D":{"sender":"50662003841@s.whatsapp.net","text":"Hablando","type":"conversation","timestamp":1791261571933},"AC3DD2C8