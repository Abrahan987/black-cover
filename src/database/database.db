i* • */saitest* + _<descripción>_\n> 〄 ɢᴇɴᴇʀᴀ ᴜɴ sᴛɪᴄᴋᴇʀ ᴄᴏɴ ɪᴀ ᴀ ᴘᴀʀᴛɪʀ ᴅᴇ ᴜɴᴀ ᴅᴇsᴄʀɪᴘᴄɪóɴ.\n\n₍ᐢ..ᐢ₎ ᜒ */sunoai* • */suno* • */musicai* + _<letra>_\n> 〄 ɢᴇɴᴇʀᴀ ᴜɴᴀ ᴄᴀɴᴄɪóɴ ᴄᴏɴ ɪᴀ ᴀ ᴘᴀʀᴛɪʀ ᴅᴇ ᴛᴜ ʟᴇᴛʀᴀ.\n\n₍ᐢ..ᐢ₎ ᜒ */tohijab* • */hijab* + _<imagen>_\n> 〄 ʟᴇ ᴘᴏɴᴇ ʜɪᴊᴀʙ ᴀ ʟᴀ ᴘᴇʀsᴏɴᴀ ᴅᴇ ᴜɴᴀ ɪᴍᴀɢᴇɴ.\n\n₍ᐢ..ᐢ₎ ᜒ */tomekah* • */mekah* + _<imagen>_\n> 〄 ʀᴇɪᴍᴀɢɪɴᴀ ᴜɴᴀ ғᴏᴛᴏ ᴇɴ ᴜɴᴀ ᴘᴇʀᴇɢʀɪɴᴀᴄɪóɴ ᴀ ʟᴀ ᴍᴇᴄᴀ.\n╰╼ׅࣶ፝֟╾╌ֵ╾͜─ํ͜┈ְ ࣭࣪⢏࣭ࣧ⢢࣭ׄ᎐፝֟͟͝᎐࣭ׄ⡔࣭ࣧ⡹࣭ׄ ְ┈ํ͜─͜╼ꨪᰰ╾࣮╌╼ࣶׅ፝֟╾╯\n\n╭╼ׅࣶ፝֟╾╌ֵ╾͜─ํ͜┈ְ ࣭࣪⢏࣭ࣧ⢢࣭ׄ᎐፝֟͟͝᎐࣭ׄ⡔࣭ࣧ⡹࣭࣭ׄ࣪ ְ┈ํ͜─͜╼ꨪᰰ╾࣮╌╼ࣶׅ፝֟╾╮\n✐ *CATEGORÍA ANIME*\n\n₍ᐢ..ᐢ₎ ᜒ */angry* + _<mention>_\n> 〄 ᴇsᴛᴀʀ ᴇɴᴏᴊᴀᴅᴏ.\n\n₍ᐢ..ᐢ₎ ᜒ */bath* + _<mention>_\n> 〄 ʙᴀñᴀʀsᴇ.\n\n₍ᐢ..ᐢ₎ ᜒ */bite* • */morder* + _<mention>_\n> 〄 ᴍᴏʀᴅᴇʀ.\n\n₍ᐢ..ᐢ₎ ᜒ */bleh* + _<mention>_\n> 〄 sᴀᴄᴀʀ ʟᴀ ʟᴇɴɢᴜᴀ.\n\n₍ᐢ..ᐢ₎ ᜒ */blowkiss* + _<mention>_\n> 〄 ʟᴀɴᴢᴀʀ ᴜɴ ʙᴇsᴏ.\n\n₍ᐢ..ᐢ₎ ᜒ */blush* + _<mention>_\n> 〄 sᴏɴʀᴏᴊᴀʀsᴇ.\n\n₍ᐢ..ᐢ₎ ᜒ */bonk* + _<mention>_\n> 〄 ɢᴏʟᴘᴇᴀʀ.\n\n₍ᐢ..ᐢ₎ ᜒ */bored* • */aburrido* + _<mention>_\n> 〄 ᴇsᴛᴀʀ ᴀʙᴜʀʀɪᴅᴏ.\n\n₍ᐢ..ᐢ₎ ᜒ */bully* + _<mention>_\n> 〄 ʜᴀᴄᴇʀ ʙᴜʟʟ","type":"extendedTextMessage","timestamp":1791143040918},"AC900AA12AC7CAECE48296ED34D76A1C":{"sender":"5491164664880@s.whatsapp.net","text":"son diferentes","type":"conversation","timestamp":1791143043853},"AC93DF2224D401E5461ECF97CE3FCE9B":{"sender":"5491164664880@s.whatsapp.net","text":"","type":"stickerMessage","timestamp":1791143046694},"ACA8F5DB7CFA5C18C29E76ACD6053CAE":{"sender":"93983162236998@lid","text":"Muchos bots","type":"conversation","timestamp":1791143046988},"AC243CD521295226F1A19F31E950ECCA":{"sender":"93983162236998@lid","text":"Ozizi","type":"extendedTextMessage","timestamp":1791143053400},"ACE47D591D2D6D0B1E6A40D93BF4B946":{"sender":"93983162236998@lid","text":".ytmp3 estupefacientes","type":"conversation","timestamp":1791143080010},"AC82C35C9607804F20F47976899B492E":{"sender":"5491164664880@s.whatsapp.net","text":"son dos nomás we","type":"extendedTextMessage","timestamp":1791143089904},"AC5BF2A1ED22EFD227F620A517840332"